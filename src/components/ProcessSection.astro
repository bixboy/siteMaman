---
import { processSteps } from '@data/services';
---
<section class="section section--process">
  <div class="process__inner">
    <h2 class="section__heading">Votre projet en 4 étapes</h2>
    <p class="section__intro">
      De la première prise de contact à la livraison de votre pièce restaurée, chaque étape
      est guidée par la précision et la passion du métier de tapissier.
    </p>
    <ol class="process__list">
      {processSteps.map((step, index) => (
        <li>
          <div class="process__badge">{index + 1}</div>
          <div>
            <h3>{step.title}</h3>
            <p>{step.detail}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .section--process {
    background: linear-gradient(135deg, rgba(176, 92, 68, 0.06), rgba(45, 42, 38, 0.05));
  }

  .process__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding-inline: var(--spacing-sm);
  }

  .process__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--spacing-sm);
  }

  .process__list li {
    display: grid;
    gap: var(--spacing-sm);
    grid-template-columns: auto 1fr;
    align-items: start;
    background: var(--color-surface);
    border-radius: 1rem;
    padding: var(--spacing-md);
    box-shadow: 0 8px 28px rgba(45, 42, 38, 0.08);
  }

  .process__badge {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: #fff;
    display: grid;
    place-items: center;
    font-weight: 600;
  }

  h3 {
    margin: 0 0 0.35rem;
    font-family: 'Cormorant Garamond', Georgia, serif;
  }

  p {
    margin: 0;
    color: var(--color-muted);
  }
</style>
