---
import BaseLayout from '@layouts/BaseLayout.astro';
import { projects } from '@data/projects';
import { siteConfig } from '@data/site';
import LightboxGallery from '@components/LightboxGallery.astro';
import { projectSchema } from '@utils/schema';

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
const pageUrl = `${siteConfig.baseUrl}/realisations/${project.slug}`;
const breadcrumbs = [
  { name: 'Accueil', url: `${siteConfig.baseUrl}/` },
  { name: 'Réalisations', url: `${siteConfig.baseUrl}/realisations` },
  { name: project.title, url: pageUrl }
];
const gallery = [
  {
    src: project.beforeImage.src,
    alt: project.beforeImage.alt,
    caption: `Avant restauration — ${project.title}`
  },
  {
    src: project.afterImage.src,
    alt: project.afterImage.alt,
    caption: `Après restauration — ${project.title}`
  }
];
---
<BaseLayout
  title={`${project.title} — Réalisation Main é merveille`}
  description={project.summary}
  canonical={pageUrl}
  structuredData={projectSchema(project)}
  breadcrumbs={breadcrumbs}
>
  <article class="section">
    <div class="container">
      <p class="breadcrumb">
        <a href="/realisations">← Retour aux réalisations</a>
      </p>
      <h1 class="section__heading">{project.title}</h1>
      <p class="section__intro">{project.summary}</p>
      <LightboxGallery images={gallery} label={`Galerie ${project.title}`} />
      <section class="details">
        <div>
          <h2>Contexte</h2>
          <p>{project.description}</p>
        </div>
        <div class="details__grid">
          <div>
            <h3>Matériaux sélectionnés</h3>
            <ul>
              {project.materials.map((material) => (
                <li>{material}</li>
              ))}
            </ul>
          </div>
          <div>
            <h3>Techniques</h3>
            <ul>
              {project.techniques.map((technique) => (
                <li>{technique}</li>
              ))}
            </ul>
          </div>
          <div>
            <h3>Durée</h3>
            <p>{project.duration}</p>
          </div>
        </div>
      </section>
      <p>
        Vous souhaitez restaurer une pièce similaire ?
        <a href="/contact">Parlez-moi de votre projet</a>.
      </p>
    </div>
  </article>
</BaseLayout>
<style>
  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding-inline: var(--spacing-sm);
    display: grid;
    gap: var(--spacing-md);
  }

  .breadcrumb {
    margin: 0;
    font-size: 0.95rem;
  }

  .details {
    display: grid;
    gap: var(--spacing-md);
  }

  .details__grid {
    display: grid;
    gap: var(--spacing-md);
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }

  ul {
    list-style: disc;
    padding-left: 1.2rem;
    margin: 0;
  }
</style>
