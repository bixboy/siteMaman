{#- `nav` (en-tête de la page) = clé du lien actif -#}
{%- set liens = [
  { cle: "accueil", texte: "Home", url: "/" },
  { cle: "services", texte: "Mes services", url: "/#prestations" },
  { cle: "realisations", texte: "Réalisations", url: "/realisations.html" },
  { cle: "vente", texte: "Vente Fauteuils", url: "/market.html" },
  { cle: "contact", texte: "Contact", url: "/contact/contact.html" }
] -%}
<nav class="box_navbar">
    <a class="logo" href="/"><img src="/resources/favicon.ico" alt="{{ site.nom }} - accueil"></a>

    <ul class="linksOrdi">
      {%- for lien in liens %}
      <li{% if lien.cle == nav %} class="acti"{% endif %}><a href="{{ lien.url }}"{% if lien.cle == nav %} aria-current="page"{% endif %}>{{ lien.texte }}</a></li>
      {%- endfor %}
    </ul>

    <div class="menu" id="menu">
      <div class="menu-btn">
        <label for="menu-check">
          <span></span>
          <span></span>
          <span></span>
        </label>
      </div>
    </div>

    <div class="nav-links">
      <ul class="links">
        {%- for lien in liens %}
        <li><a href="{{ lien.url }}"{% if lien.cle == nav %} aria-current="page"{% endif %}>{{ lien.texte }}</a></li>
        {%- endfor %}
      </ul>

      <div class="infs">
        <h1 class="nameNav">Entreprise {{ site.nom }} </h1>

        <div class="tel"> <img src="/resources/tel.webp" alt="tel-icon"> <a href="tel:{{ site.telephone }}">Appelez-moi</a></div>

        <div class="mail"> <img src="/resources/email.webp" alt="mail-icon"> <a
            href="mailto:{{ site.email }}">{{ site.email }}</a></div>

        <div class="media">
          <div class="icon_media_menu">
            <a href="{{ site.facebook }}" class="icon-box"><img src="/resources/facebookwhite.webp" alt="facebook"></a>
          </div>
        </div>

      </div>
    </div>

    <div class="background-menu"></div>
  </nav>
