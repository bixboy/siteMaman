---
title: "Réalisations avant / après | Tapissière à Caen | Main é Merveille"
image: "/resources/Realisations/siege7.webp"
description: "Fauteuils, chaises et canapés restaurés par Main é Merveille, tapissière d'ameublement à Caen : découvrez mes réalisations en avant / après."
permalink: realisations.html
nav: realisations
styles:
  - components/bandeau.css
  - components/modale.css
  - components/avant-apres.css
  - components/appel.css
  - pages/realisations.css
---
{%- from "partials/bandeau.njk" import bandeau with context -%}
{%- from "partials/icones.njk" import icone -%}

{{ bandeau({
  surTitre: "Avant / après",
  titre: "Mes réalisations",
  texte: "Cliquez sur une photo pour l'agrandir. Sur un « avant / après », faites glisser le curseur pour comparer."
}) }}

<section class="section">
  <div class="conteneur">
    {#- Contenu : src/_data/realisations.yml (mosaïque : chaque photo garde ses proportions) #}
    <ul class="galerie">
      {%- for realisation in realisations %}
      {%- set alt = realisation.alt or "Réalisation " + loop.index %}
      <li class="galerie__element" data-reveal>
        {%- if realisation.photo %}
        <button class="cadre galerie__bouton" type="button" data-photo="{{ ("/resources/" ~ realisation.photo) | url }}">
          {% image realisation.photo, alt, "(max-width: 600px) 92vw, (max-width: 1000px) 46vw, 360px" %}
          <span class="galerie__survol">{{ icone("agrandir") }}<span class="visuellement-cache">Agrandir la photo</span></span>
        </button>
        {%- else %}
        <button class="cadre galerie__bouton" type="button"
          data-avant="{{ ("/resources/" ~ realisation.avant) | url }}" data-apres="{{ ("/resources/" ~ realisation.apres) | url }}">
          {% image realisation.vignette or realisation.apres, alt, "(max-width: 600px) 92vw, (max-width: 1000px) 46vw, 360px" %}
          <span class="etiquette galerie__etiquette">Avant / après</span>
          <span class="galerie__survol">{{ icone("agrandir") }}<span class="visuellement-cache">Comparer avant et après</span></span>
        </button>
        {%- endif %}
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>

{% include "partials/appel.njk" %}
{% include "partials/modale-avant-apres.njk" %}
{% include "partials/modale-photo.njk" %}
