---
import { services } from '@data/services';
---
<section class="section">
  <div class="container">
    <h2 class="section__heading">Services phares</h2>
    <p class="section__intro">
      Réfection sur mesure : garnissage traditionnel, restauration de canapés et mise en
      beauté de vos fauteuils et chaises.
    </p>
    <div class="grid grid--three">
      {services.map((service) => (
        <article class="card" aria-label={service.title}>
          <h3>{service.title}</h3>
          <p>{service.description}</p>
          <a class="card__link" href="/services">En savoir plus</a>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding-inline: var(--spacing-sm);
  }

  .card__link {
    font-weight: 600;
    color: var(--color-accent);
  }

  .card__link:hover,
  .card__link:focus-visible {
    text-decoration: underline;
  }
</style>
