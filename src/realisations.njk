---
title: "Réalisations - Main é merveille - Tapissier d'ameublement"
permalink: realisations.html
nav: realisations
styles:
  - components/hero.css
  - components/modal.css
  - pages/realisations.css
  - components/before-after.css
---
<div class="pcTop">
  <div class="boxImgTop">
    <img src="/resources/Realisations/background1.webp" alt="prestations" fetchpriority="high">
    <div class="coverImg">
      <h1>Toute mes réalisations</h1>
      <span>Pour avoir plus d'informations <br> envoyer moi un mail ou appelez-moi</span>
      <button data-scroll-to="containerSieges">Voir les réalisations <p class="fleche"> ^ </p>
      </button>
    </div>
  </div>
</div>

<div id="containerImg">
  <div class="boxTitleTop">
    <div class="titletTop">
      <h1>Les réalisations</h1>
      <p></p>
    </div>
  </div>

  {#- Contenu : src/_data/realisations.yml #}
  <div class="container-center" id="containerSieges">
    {%- for realisation in realisations %}
    {%- if realisation.format == "portrait" %}{% set classeFormat = "gallery-img-full" %}
    {%- elif realisation.format == "recadre" %}{% set classeFormat = "gallery-img gallery-img-cover" %}
    {%- else %}{% set classeFormat = "gallery-img" %}{% endif %}
    {%- set alt = realisation.alt or "Réalisation " + loop.index %}

    {%- if realisation.photo %}
    <div class="modal-trigger2" data-full="/resources/{{ realisation.photo }}">
      <span>Cliquer pour voir</span>
      {% image realisation.photo, alt, "300px", { class: "myImg2 " + classeFormat } %}
    </div>
    {%- else %}
    <div class="modal-trigger1" data-before="/resources/{{ realisation.avant }}"
      data-after="/resources/{{ realisation.apres }}">
      <span>Cliquer pour voir</span>
      {% image realisation.vignette or realisation.apres, alt, "300px", { class: "myImg " + classeFormat } %}
    </div>
    {%- endif %}
    {%- endfor %}
  </div>
</div>

<!-- The Modal -->
<div id="myModal" class="modal">
  <span class="close">&times;</span>

  <div class="container" id="img01">
    <div class="slider slider--tokyo">
      <div class="slider__before"></div>
      <div class="slider__separator"></div>
      <div class="slider__after"></div>
      <input class="slider__range" type="range" min="0" max="100" value="50" aria-label="Comparer avant et après" />
    </div>
  </div>

  <div id="caption"></div>
</div>

<div id="myModalIMG" class="modal">
  <span class="close2">&times;</span>
  <img class="modal-content" id="image" alt="">
  <div id="caption2"></div>
</div>

<div class="contact">
  <div>
    <h1>Contactez-moi</h1>
    <span class="trait"></span>
    <a href="tel:{{ site.telephone }}"><img src="/resources/tel.webp" alt="tel" loading="lazy"> Appel</a>
  </div>
</div>
