---
const { title, subtitle, description } = Astro.props as {
  title: string;
  subtitle: string;
  description: string;
};
---
<section class="hero">
  <div class="hero__content">
    <p class="hero__eyebrow">Tapissière d'ameublement</p>
    <h1>{title}</h1>
    <p class="hero__subtitle">{subtitle}</p>
    <p class="hero__description">{description}</p>
    <div class="hero__actions">
      <a class="btn" href="/contact">Demander un devis</a>
      <a class="btn btn--outline" href="/realisations">Voir les réalisations</a>
    </div>
  </div>
  <figure class="hero__media">
    <picture>
      <source
        srcset="https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=1200&q=60"
        type="image/jpeg"
      />
      <img
        src="https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=800&q=60"
        alt="Tapissière d'ameublement travaillant sur un fauteuil"
        loading="lazy"
        decoding="async"
      />
    </picture>
    <figcaption>Réfection artisanale, détails soignés et tissus d'exception.</figcaption>
  </figure>
</section>
<style>
  .hero {
    display: grid;
    gap: var(--spacing-lg);
    align-items: center;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: calc(var(--spacing-xl) + 1.5rem) var(--spacing-sm) var(--spacing-lg);
  }

  .hero__eyebrow {
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: var(--color-muted);
    margin-bottom: var(--spacing-xs);
  }

  h1 {
    margin: 0;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2.8rem, 5vw, 4rem);
  }

  .hero__subtitle {
    font-size: 1.35rem;
    color: var(--color-muted);
    margin-bottom: var(--spacing-sm);
  }

  .hero__description {
    max-width: 55ch;
    margin-bottom: var(--spacing-md);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  .hero__media {
    margin: 0;
    position: relative;
  }

  .hero__media img {
    width: 100%;
    border-radius: 1.5rem;
    box-shadow: 0 18px 48px rgba(45, 42, 38, 0.18);
  }

  .hero__media::after {
    content: '';
    position: absolute;
    inset: auto 8% -8% auto;
    width: 60%;
    height: 40%;
    background: rgba(176, 92, 68, 0.15);
    border-radius: 999px;
    filter: blur(40px);
    z-index: -1;
  }

  figcaption {
    margin-top: var(--spacing-xs);
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }
</style>
