{#- Icônes SVG au trait (style Feather). Usage : {% from "partials/icones.njk" import icone %} {{ icone("telephone") }} -#}
{% macro icone(nom) -%}
<svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- if nom == "telephone" %}<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
  {%- elif nom == "email" %}<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
  {%- elif nom == "lieu" %}<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
  {%- elif nom == "horloge" %}<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
  {%- elif nom == "facebook" %}<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
  {%- elif nom == "fleche-haut" %}<line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/>
  {%- elif nom == "precedent" %}<polyline points="15 18 9 12 15 6"/>
  {%- elif nom == "suivant" %}<polyline points="9 18 15 12 9 6"/>
  {%- elif nom == "fermer" %}<line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
  {%- elif nom == "agrandir" %}<polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/>
  {%- endif %}
</svg>
{%- endmacro %}
