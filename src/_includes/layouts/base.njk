<!DOCTYPE html>
<html lang="fr">

<head>
  {#- Google Tag Manager : chargé par js/consent.js seulement après consentement (partials/consentement.njk) #}
  {%- set metaDescription = (description or site.description) | uneLigne %}
  {%- set canonical = site.url + page.url %}
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ metaDescription }}">
  <link rel="canonical" href="{{ canonical }}">
  {%- if apercu %}
  <meta name="robots" content="noindex, nofollow">
  {%- elif robots %}
  <meta name="robots" content="{{ robots }}">
  {%- endif %}
  <meta name="theme-color" content="#f8f4ec">

  <meta property="og:type" content="website">
  <meta property="og:locale" content="fr_FR">
  <meta property="og:site_name" content="{{ site.nom }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ metaDescription }}">
  <meta property="og:image" content="{{ site.url }}{{ image or site.image }}">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="icon" href="/resources/favicon.ico" type="image/x-icon">
  {#- Polices des titres et du texte, visibles dès le premier affichage #}
  <link rel="preload" href="/fonts/cormorant-garamond-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/source-sans-3-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>

  <link rel="stylesheet" href="/css/polices.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/layout.css">
  {%- for feuille in styles %}
  <link rel="stylesheet" href="/css/{{ feuille }}">
  {%- endfor %}

  {% include "partials/jsonld.njk" %}
</head>

<body>
  <a class="lien-evitement" href="#contenu">Aller au contenu</a>
  {%- if apercu %}
  <p class="badge-apercu">Aperçu de test — non publié</p>
  {%- endif %}

  {% include "partials/entete.njk" %}

  <main id="contenu">
    {{ content | trim | safe }}
  </main>

  {% include "partials/pied.njk" %}
  {% include "partials/consentement.njk" %}

  <script type="module" src="/js/main.js"></script>
</body>

</html>
